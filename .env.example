AUREON_HOST=127.0.0.1
AUREON_PORT=8787
AUREON_MODE=local
AUREON_DATA_DIR=data
AUREON_DB_PATH=data/aureon.sqlite3
AUREON_LOG_LEVEL=INFO

# Optional provider credentials. Fill only the services you actually use.
# Never commit tokens, passwords, cookies, or OAuth refresh tokens.

AUREON_SHOPIFY_STORE=
AUREON_SHOPIFY_ACCESS_TOKEN=
AUREON_PRINTIFY_API_TOKEN=

# Optional OpenAI-compatible AI analyst for objective-driven missions.
# Use an HTTPS chat-completions base URL and a model supported by your provider.
AUREON_AI_BASE_URL=
AUREON_AI_API_KEY=
AUREON_AI_MODEL=
